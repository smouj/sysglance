# Editor configuration — https://editorconfig.org
# Applies to every editor that honours .editorconfig (VS Code, JetBrains,
# Visual Studio, Sublime…), so contributors do not fight over whitespace.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = off

# Markdown keeps its meaningful trailing spaces (two spaces = hard line break).
[*.md]
trim_trailing_whitespace = false

# PowerShell is friendliest with CRLF.
[*.ps1]
end_of_line = crlf
indent_size = 4

# The one C# helper uses the .NET Framework conventions.
[*.cs]
indent_size = 4
end_of_line = crlf

[*.{yml,yaml}]
indent_size = 2

[*.{html,css}]
indent_size = 2

[Makefile]
indent_style = tab
