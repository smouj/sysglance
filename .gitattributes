# Normalize line endings in the repository so a Windows contributor and a
# Linux/WSL contributor produce identical diffs.
* text=auto eol=lf

# PowerShell is happiest with CRLF; the C# helper targets the .NET Framework.
*.ps1 text eol=crlf
*.cs  text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets — never diff, never normalise.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.exe  binary
*.dll  binary

# Keep the lockfile out of language statistics and out of merge conflicts:
# it is regenerated by `npm install`, never hand-merged.
package-lock.json -diff linguist-generated=true
CHANGELOG.md      linguist-documentation
docs/**           linguist-documentation
