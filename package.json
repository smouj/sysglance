{
  "name": "sysglance",
  "version": "1.3.0",
  "description": "Fast always-on-top system glance for CPU, memory, GPU, storage, network, processes and home folders.",
  "main": "src/main.js",
  "author": { "name": "smouj", "email": "61901624+smouj@users.noreply.github.com", "url": "https://github.com/smouj" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/smouj/sysglance.git" },
  "homepage": "https://github.com/smouj/sysglance#readme",
  "bugs": { "url": "https://github.com/smouj/sysglance/issues" },
  "keywords": ["system-monitor","desktop-overlay","hud","cpu","ram","gpu","hardware","monitoring","electron","always-on-top"],
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "self-test": "electron . --self-test",
    "verify": "npm run verify:syntax && npm run verify:config && npm run verify:ui",
    "verify:config": "node scripts/verify-config.js",
    "verify:syntax": "node scripts/verify-syntax.js",
    "verify:ui": "node scripts/verify-ui.js",
    "bench": "node scripts/bench-metrics.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.sysglance.app",
    "productName": "SysGlance",
    "copyright": "Copyright © 2026 smouj",
    "directories": { "output": "dist" },
    "compression": "maximum",
    "files": ["src/**/*","assets/**/*","!**/*.map","!**/.openclaw/**"],
    "publish": null,
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.png",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "SysGlance-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SysGlance",
      "runAfterFinish": true,
      "artifactName": "SysGlance-Setup-${version}.${ext}",
      "uninstallDisplayName": "SysGlance ${version}"
    },
    "linux": {
      "target": ["AppImage","deb"],
      "icon": "assets/icon.png",
      "category": "System",
      "synopsis": "Always-on-top system glance",
      "description": "Real-time CPU, memory, GPU, storage, network, filesystem and process monitoring in a compact always-on-top overlay.",
      "desktop": { "entry": { "Name": "SysGlance", "Comment": "Always-on-top system glance", "Categories": "System;Monitor;Utility;" } },
      "artifactName": "SysGlance-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "SysGlance-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": { "electron": "^33.0.0", "electron-builder": "^25.0.0" },
  "dependencies": { "systeminformation": "^5.23.0" }
}
