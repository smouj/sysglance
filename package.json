{
  "name": "sysglance",
  "version": "1.1.0",
  "description": "Futuristic semi-transparent desktop overlay for real-time PC monitoring — CPU, RAM, GPU, disks, network, filesystem, processes. Runs in background, no server required.",
  "main": "src/main.js",
  "author": "SysGlance",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/smouj/sysglance"
  },
  "keywords": [
    "system-monitor",
    "desktop-overlay",
    "hud",
    "cpu",
    "ram",
    "gpu",
    "hardware",
    "monitoring",
    "electron",
    "transparent",
    "always-on-top"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.sysglance.app",
    "productName": "SysGlance",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SysGlance",
      "runAfterFinish": true,
      "allowElevation": false
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png",
      "category": "System"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "systeminformation": "^5.23.0"
  }
}
