{
  "name": "sysglance",
  "version": "1.2.0",
  "description": "On-demand desktop control center for Windows and Linux: CPU, memory, GPU, disks, network, filesystem and the Windows shell (taskbar position, dark mode, accent, wallpaper) in a semi-transparent always-on-top overlay.",
  "main": "src/main.js",
  "author": {
    "name": "smouj",
    "url": "https://github.com/smouj"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smouj/sysglance.git"
  },
  "homepage": "https://github.com/smouj/sysglance#readme",
  "bugs": {
    "url": "https://github.com/smouj/sysglance/issues"
  },
  "keywords": [
    "system-monitor",
    "desktop-overlay",
    "hud",
    "cpu",
    "ram",
    "gpu",
    "hardware",
    "monitoring",
    "electron",
    "transparent",
    "always-on-top",
    "taskbar",
    "windows-shell",
    "systeminformation"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "self-test": "electron . --self-test",
    "screenshot": "electron . --screenshot",
    "verify": "node scripts/verify-syntax.js && node scripts/verify-config.js && node scripts/verify-shell.js",
    "verify:config": "node scripts/verify-config.js",
    "verify:shell": "node scripts/verify-shell.js",
    "verify:syntax": "node scripts/verify-syntax.js",
    "bench": "node scripts/bench-metrics.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.sysglance.app",
    "productName": "SysGlance",
    "copyright": "Copyright © 2026 smouj",
    "directories": {
      "output": "dist"
    },
    "compression": "maximum",
    "files": [
      "src/**/*",
      "assets/**/*",
      "!src/native/shell/*.exe",
      "!**/*.map",
      "!**/.openclaw/**"
    ],
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "SysGlance-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SysGlance",
      "runAfterFinish": true,
      "artifactName": "SysGlance-Setup-${version}.${ext}",
      "uninstallDisplayName": "SysGlance ${version}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png",
      "category": "System",
      "synopsis": "On-demand desktop control center",
      "description": "Real-time CPU, memory, GPU, disk, network, filesystem and process monitoring, plus Windows shell configuration, in a semi-transparent always-on-top overlay.",
      "desktop": {
        "entry": {
          "Name": "SysGlance",
          "Comment": "On-demand desktop control center",
          "Categories": "System;Monitor;Utility;"
        }
      },
      "artifactName": "SysGlance-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "SysGlance-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "systeminformation": "^5.23.0"
  }
}
